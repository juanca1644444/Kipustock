# ==============================================================
# KIPUSTOCK - REGLAS DE GITIGNORE PARA SEGURIDAD Y DESPLIEGUE
# ==============================================================

# 1. Variables de entorno privadas (credenciales, API keys)
.env
.env.local
.env.*.local

# 2. Bases de datos y archivos de datos locales
*.db
*.db-journal
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3

# 3. Caché de búsqueda, logs y estado temporal
data/search_cache.json
data/*.tmp
data/*.log
*.log
data/*.png
data/*.jpg
data/unlock_status.json
data/backup_*.json
data/tunnel_*.json

# 4. Perfiles pesados de navegador Playwright / Chromium
data/browser_profile/
data/test_profile/
data/test_profile*/

# 5. Archivos multimedia generados localmente y uploads temporales
data/uploads/*
!data/uploads/.gitkeep
data/product_images/*
!data/product_images/.gitkeep
data/quotes/*
!data/quotes/.gitkeep
data/bin/*
!data/bin/.gitkeep
data/campaigns/*
!data/campaigns/.gitkeep

# 6. Python bytecode, scripts de prueba temporales y entornos virtuales
__pycache__/
*.py[cod]
*$py.class
test_*.py
venv/
.venv/
env/
.env/

# 7. Ejecutables y binarios descargados automáticamente
*.exe
bin/*.exe
!bin/.gitkeep

# 8. IDE y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
