# ==============================================================
# CONFIGURACIÓN DE KIPUSTOCK (Fase 2 - Cloud $0 & Local)
# ==============================================================

# 1. Base de datos en la nube ($0 en Supabase o Neon)
# Si se deja vacío, Kipustock utilizará automáticamente SQLite local en data/sistema.db
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres"

# 2. IA de Reconocimiento Visual y Arbitraje
# Obtén tu API Key gratuita en: https://aistudio.google.com/
GEMINI_API_KEY="tu_api_key_gratuita_de_google_ai_studio"

# 3. Parámetros comerciales
# Porcentaje predeterminado de comisión de venta y envíos (%)
DEFAULT_COMMISSION_PERCENT=12.0

# 4. Modo de despliegue (Opcional, en Render o hosting gratuito poner 'true')
IS_CLOUD=false

